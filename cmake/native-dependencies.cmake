# Native CI uses verified source archives, not DLLs taken from other plugins.
set(HYPERDSP_DEPS_ROOT "" CACHE PATH "Unpacked, verified dependency sources")
if(NOT HYPERDSP_DEPS_ROOT)
    message(FATAL_ERROR "Native dependency sources required; see docs/ci.md")
endif()
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(JANSSON_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(JANSSON_BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(JANSSON_EXAMPLES OFF CACHE BOOL "" FORCE)
set(JANSSON_WITHOUT_TESTS ON CACHE BOOL "" FORCE)
set(JANSSON_INSTALL OFF CACHE BOOL "" FORCE)
# Both pinned dependencies declare CMake 3.1. CMake 4 removed support
# for policies older than 3.5. Scope the floor to dependency configuration;
# preserve a caller's higher floor and leave our policies alone.
function(hyperdsp_add_dependency source binary)
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 4.0 AND
       (NOT DEFINED CMAKE_POLICY_VERSION_MINIMUM OR CMAKE_POLICY_VERSION_MINIMUM VERSION_LESS 3.5))
        set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
    endif()
    add_subdirectory("${source}" "${binary}" EXCLUDE_FROM_ALL)
endfunction()
hyperdsp_add_dependency("${HYPERDSP_DEPS_ROOT}/jansson-2.14.1" "${CMAKE_BINARY_DIR}/deps/jansson")
set(JANSSON_INCLUDE_DIR "${CMAKE_BINARY_DIR}/deps/jansson/include")
set(JANSSON_LIBRARY jansson)
set(LADSPA_INCLUDE_DIR "${HYPERDSP_DEPS_ROOT}/ladspa_sdk_1.17/src")
set(LIBSAMPLERATE_EXAMPLES OFF CACHE BOOL "" FORCE)
set(LIBSAMPLERATE_INSTALL OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF)
# Avoid injecting dependency self-tests into HyperDSP's exact test inventory.
set(_hyperdsp_testing ${BUILD_TESTING})
set(BUILD_TESTING OFF CACHE BOOL "Build dependency self-tests" FORCE)
set(BUILD_TESTING OFF)
hyperdsp_add_dependency("${HYPERDSP_DEPS_ROOT}/libsamplerate-0.2.2" "${CMAKE_BINARY_DIR}/deps/samplerate")
set(BUILD_TESTING ${_hyperdsp_testing} CACHE BOOL "Build HyperDSP tests" FORCE)
set(BUILD_TESTING ${_hyperdsp_testing})
set(SAMPLERATE_INCLUDE_DIR "${HYPERDSP_DEPS_ROOT}/libsamplerate-0.2.2/include")
set(SAMPLERATE_LIBRARY samplerate)
install(FILES "${HYPERDSP_DEPS_ROOT}/jansson-2.14.1/LICENSE" DESTINATION data/licenses/jansson)
install(FILES "${HYPERDSP_DEPS_ROOT}/libsamplerate-0.2.2/COPYING" DESTINATION data/licenses/libsamplerate RENAME LICENSE)
install(FILES "${HYPERDSP_DEPS_ROOT}/ladspa_sdk_1.17/doc/COPYING" DESTINATION data/licenses/ladspa-sdk RENAME LICENSE)
